generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "ts"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        Int        @id @default(autoincrement())
  createdAt DateTime   @default(now()) @map("created_at")
  sessions  Session[]
  pairCodes PairCode[]
  character Character?

  @@map("users")
}

model AccessCode {
  code      String   @id
  maxUses   Int      @map("max_uses")
  uses      Int      @default(0)
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("access_codes")
}

model Session {
  id        Int      @id @default(autoincrement())
  tokenHash String   @unique @map("token_hash")
  userId    Int      @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at")

  @@map("sessions")
}

/// Short-lived code that logs another device into an existing account (`quest pair`).
model PairCode {
  codeHash  String   @id @map("code_hash")
  userId    Int      @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("pair_codes")
}

model Character {
  id         Int          @id @default(autoincrement())
  userId     Int          @unique @map("user_id")
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String       @unique
  xp         Int          @default(0)
  gold       Int          @default(0)
  quests     Quest[]
  items      Item[]
  encounters Encounter[]
  draws      MarketDraw[]
  createdAt  DateTime     @default(now()) @map("created_at")

  @@map("characters")
}

/// `slots` is a bitmask, one bit per 5-minute slot with presence. `resolvedAt` is null while running.
model Quest {
  id          Int       @id @default(autoincrement())
  characterId Int       @map("character_id")
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  startedAt   DateTime  @map("started_at")
  endsAt      DateTime  @map("ends_at")
  slots       Int       @default(0)
  resolvedAt  DateTime? @map("resolved_at")
  success     Boolean?
  xp          Int       @default(0)
  gold        Int       @default(0)
  lootItemId  Int?      @unique @map("loot_item_id")
  lootItem    Item?     @relation(fields: [lootItemId], references: [id], onDelete: SetNull)

  @@index([characterId, startedAt])
  @@map("quests")
}

/// An item owned by a character. `key` refers to the catalog in packages/shared, the stats are rolled on drop.
model Item {
  id           Int        @id @default(autoincrement())
  characterId  Int        @map("character_id")
  character    Character  @relation(fields: [characterId], references: [id], onDelete: Cascade)
  key          String
  attack       Int        @default(0)
  defense      Int        @default(0)
  luck         Int        @default(0)
  fortune      Int        @default(0)
  equippedSlot String?    @map("equipped_slot")
  /// Set while the item is offered on the market. Listed items cannot be equipped.
  listedAt     DateTime?  @map("listed_at")
  createdAt    DateTime   @default(now()) @map("created_at")
  foundIn      Quest?
  wonIn        Encounter?

  @@unique([characterId, equippedSlot])
  @@map("items")
}

/// A monster that appeared on a heartbeat. Unfought encounters simply expire, `foughtAt` is set once fought.
model Encounter {
  id          Int       @id @default(autoincrement())
  characterId Int       @map("character_id")
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  monster     String
  level       Int
  expiresAt   DateTime  @map("expires_at")
  foughtAt    DateTime? @map("fought_at")
  won         Boolean?
  xp          Int       @default(0)
  gold        Int       @default(0)
  lootItemId  Int?      @unique @map("loot_item_id")
  lootItem    Item?     @relation(fields: [lootItemId], references: [id], onDelete: SetNull)
  createdAt   DateTime  @default(now()) @map("created_at")

  @@index([characterId, createdAt])
  @@map("encounters")
}

/// One market purchase. Used for the daily draw limit and as history.
model MarketDraw {
  id        Int       @id @default(autoincrement())
  buyerId   Int       @map("buyer_id")
  buyer     Character @relation(fields: [buyerId], references: [id], onDelete: Cascade)
  sellerId  Int       @map("seller_id")
  itemId    Int       @map("item_id")
  rarity    String
  price     Int
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([buyerId, createdAt])
  @@map("market_draws")
}
