generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "ts"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        Int        @id @default(autoincrement())
  /// Banned players are rejected on every authenticated route.
  bannedAt  DateTime?  @map("banned_at")
  createdAt DateTime   @default(now()) @map("created_at")
  sessions  Session[]
  pairCodes PairCode[]
  character Character?

  @@map("users")
}

model AccessCode {
  code      String   @id
  maxUses   Int      @map("max_uses")
  uses      Int      @default(0)
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("access_codes")
}

model Session {
  id        Int      @id @default(autoincrement())
  tokenHash String   @unique @map("token_hash")
  userId    Int      @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at")

  @@map("sessions")
}

/// Short-lived code that logs another device into an existing account (`quest pair`).
model PairCode {
  codeHash  String   @id @map("code_hash")
  userId    Int      @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("pair_codes")
}

model Character {
  id           Int             @id @default(autoincrement())
  userId       Int             @unique @map("user_id")
  user         User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  name         String          @unique
  xp           Int             @default(0)
  gold         Int             @default(0)
  /// Shown combat power from level, gear and talents, without guild buffs. Kept for the leaderboard by syncProgress.
  power        Int             @default(0)
  /// Learned talent ranks by talent key, see packages/shared/src/talents.ts.
  talents      Json            @default("{}")
  /// Website tour: new, skipped or done. Done unlocks an achievement.
  tour         String          @default("new")
  /// Notifications created after this are unread.
  inboxSeenAt  DateTime        @default(now()) @map("inbox_seen_at")
  quests       Quest[]
  items        Item[]
  encounters   Encounter[]
  draws        MarketDraw[]
  bids         MarketBid[]
  inbox        Notification[]
  dungeons     DungeonMember[]
  guild        GuildMember?
  raids        RaidMember[]
  purchases    ShopPurchase[]
  achievements Achievement[]
  ideas        Idea[]
  ideaVotes    IdeaVote[]
  createdAt    DateTime        @default(now()) @map("created_at")

  @@index([power])
  @@map("characters")
}

/// `resolvedAt` is null while running.
model Quest {
  id          Int       @id @default(autoincrement())
  characterId Int       @map("character_id")
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  startedAt   DateTime  @map("started_at")
  endsAt      DateTime  @map("ends_at")
  resolvedAt  DateTime? @map("resolved_at")
  success     Boolean?
  xp          Int       @default(0)
  gold        Int       @default(0)
  lootItemId  Int?      @unique @map("loot_item_id")
  lootItem    Item?     @relation(fields: [lootItemId], references: [id], onDelete: SetNull)

  @@index([characterId, startedAt])
  @@map("quests")
}

/// An item owned by a character. `key` refers to the catalog in packages/shared, the stats are rolled on drop.
model Item {
  id           Int            @id @default(autoincrement())
  characterId  Int            @map("character_id")
  character    Character      @relation(fields: [characterId], references: [id], onDelete: Cascade)
  key          String
  attack       Int            @default(0)
  defense      Int            @default(0)
  luck         Int            @default(0)
  fortune      Int            @default(0)
  equippedSlot String?        @map("equipped_slot")
  /// Set while the item is offered on the market, with the seller's price. Listed items cannot be equipped.
  listedAt     DateTime?      @map("listed_at")
  price        Int?
  bids         MarketBid[]
  createdAt    DateTime       @default(now()) @map("created_at")
  foundIn      Quest?
  wonIn        Encounter?
  dungeonLoot  DungeonMember?
  raidLoot     RaidMember?

  @@unique([characterId, equippedSlot])
  @@index([listedAt])
  @@map("items")
}

/// A monster that appeared on a heartbeat. Unfought encounters simply expire, `foughtAt` is set once fought.
model Encounter {
  id          Int       @id @default(autoincrement())
  characterId Int       @map("character_id")
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  monster     String
  level       Int
  expiresAt   DateTime  @map("expires_at")
  foughtAt    DateTime? @map("fought_at")
  won         Boolean?
  xp          Int       @default(0)
  gold        Int       @default(0)
  lootItemId  Int?      @unique @map("loot_item_id")
  lootItem    Item?     @relation(fields: [lootItemId], references: [id], onDelete: SetNull)
  createdAt   DateTime  @default(now()) @map("created_at")

  @@index([characterId, createdAt])
  @@map("encounters")
}

/// One market sale, drawn or bought at once. Counted for statistics.
model MarketDraw {
  id        Int       @id @default(autoincrement())
  buyerId   Int       @map("buyer_id")
  buyer     Character @relation(fields: [buyerId], references: [id], onDelete: Cascade)
  sellerId  Int       @map("seller_id")
  itemId    Int       @map("item_id")
  rarity    String
  price     Int
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([buyerId, createdAt])
  @@map("market_draws")
}

/// A buyer in line for a listing. The price is taken from the buyer's gold on joining and refunded unless drawn.
model MarketBid {
  itemId      Int       @map("item_id")
  item        Item      @relation(fields: [itemId], references: [id], onDelete: Cascade)
  characterId Int       @map("character_id")
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  price       Int
  createdAt   DateTime  @default(now()) @map("created_at")

  @@id([itemId, characterId])
  @@index([characterId])
  @@map("market_bids")
}

/// Something that happened to a character, shown in the inbox. Deleted by the player or after 30 days.
model Notification {
  id          Int       @id @default(autoincrement())
  characterId Int       @map("character_id")
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  /// market, dungeon, raid, guild or achievement
  kind        String
  text        String
  createdAt   DateTime  @default(now()) @map("created_at")

  @@index([characterId, createdAt])
  @@map("notifications")
}

/// A dungeon run: a 5-minute lobby, then three stages and a boss of 15 minutes each.
/// `stage` counts cleared stages, `endedAt` is set when a stage fails or the boss falls.
model Dungeon {
  id        Int             @id @default(autoincrement())
  code      String          @unique
  startsAt  DateTime        @map("starts_at")
  stage     Int             @default(0)
  endedAt   DateTime?       @map("ended_at")
  success   Boolean?
  members   DungeonMember[]
  createdAt DateTime        @default(now()) @map("created_at")

  @@map("dungeons")
}

model DungeonMember {
  dungeonId   Int       @map("dungeon_id")
  dungeon     Dungeon   @relation(fields: [dungeonId], references: [id], onDelete: Cascade)
  characterId Int       @map("character_id")
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  xp          Int       @default(0)
  gold        Int       @default(0)
  lootItemId  Int?      @unique @map("loot_item_id")
  lootItem    Item?     @relation(fields: [lootItemId], references: [id], onDelete: SetNull)
  joinedAt    DateTime  @default(now()) @map("joined_at")

  @@id([dungeonId, characterId])
  @@map("dungeon_members")
}

/// Guild XP grows with the quest XP of its members.
model Guild {
  id        Int           @id @default(autoincrement())
  name      String        @unique
  code      String        @unique
  xp        Int           @default(0)
  /// Guild bank, filled by donations and a share of quest gold. The leader spends it on buffs.
  gold      Int           @default(0)
  /// Raid bosses beaten in order. The guild can raid every boss up to this index.
  raidTier  Int           @default(0) @map("raid_tier")
  members   GuildMember[]
  raids     Raid[]
  buffs     GuildBuff[]
  createdAt DateTime      @default(now()) @map("created_at")

  @@map("guilds")
}

/// A guild buff, active for every member until `endsAt`. `key` refers to the catalog in packages/shared.
model GuildBuff {
  guildId Int      @map("guild_id")
  guild   Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)
  key     String
  endsAt  DateTime @map("ends_at")

  @@id([guildId, key])
  @@map("guild_buffs")
}

/// A character is in at most one guild. `role` is `leader` or `member`.
model GuildMember {
  characterId Int       @id @map("character_id")
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  guildId     Int       @map("guild_id")
  guild       Guild     @relation(fields: [guildId], references: [id], onDelete: Cascade)
  role        String    @default("member")
  /// Gold this member gave to the guild bank.
  donated     Int       @default(0)
  joinedAt    DateTime  @default(now()) @map("joined_at")

  @@index([guildId])
  @@map("guild_members")
}

/// A scheduled guild raid. `state`: scheduled, running, won, failed or cancelled.
model Raid {
  id        Int          @id @default(autoincrement())
  guildId   Int          @map("guild_id")
  guild     Guild        @relation(fields: [guildId], references: [id], onDelete: Cascade)
  startsAt  DateTime     @map("starts_at")
  /// Index into RAID_BOSSES in packages/shared.
  tier      Int          @default(0)
  state     String       @default("scheduled")
  bossHp    Int          @default(0) @map("boss_hp")
  bossMaxHp Int          @default(0) @map("boss_max_hp")
  tick      Int          @default(0)
  members   RaidMember[]
  createdAt DateTime     @default(now()) @map("created_at")

  @@index([guildId, startsAt])
  @@map("raids")
}

model RaidMember {
  raidId      Int       @map("raid_id")
  raid        Raid      @relation(fields: [raidId], references: [id], onDelete: Cascade)
  characterId Int       @map("character_id")
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  damage      Int       @default(0)
  lootItemId  Int?      @unique @map("loot_item_id")
  lootItem    Item?     @relation(fields: [lootItemId], references: [id], onDelete: SetNull)

  @@id([raidId, characterId])
  @@map("raid_members")
}

/// One shop purchase. Each offer can be bought once per character and day.
model ShopPurchase {
  characterId Int       @map("character_id")
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  day         String
  offer       Int
  itemKey     String    @map("item_key")
  price       Int
  createdAt   DateTime  @default(now()) @map("created_at")

  @@id([characterId, day, offer])
  @@map("shop_purchases")
}

/// An unlocked achievement. Once unlocked it stays, even if the condition no longer holds.
model Achievement {
  characterId Int       @map("character_id")
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  key         String
  unlockedAt  DateTime  @default(now()) @map("unlocked_at")

  @@id([characterId, key])
  @@map("achievements")
}

/// A player's suggestion for the game. `status` is open, planned, done or rejected, set with the idea admin script.
model Idea {
  id        Int        @id @default(autoincrement())
  authorId  Int        @map("author_id")
  author    Character  @relation(fields: [authorId], references: [id], onDelete: Cascade)
  title     String
  text      String
  status    String     @default("open")
  votes     IdeaVote[]
  createdAt DateTime   @default(now()) @map("created_at")

  @@index([authorId, createdAt])
  @@map("ideas")
}

/// One upvote per player and idea.
model IdeaVote {
  ideaId      Int       @map("idea_id")
  idea        Idea      @relation(fields: [ideaId], references: [id], onDelete: Cascade)
  characterId Int       @map("character_id")
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@id([ideaId, characterId])
  @@map("idea_votes")
}
