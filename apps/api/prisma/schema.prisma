generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "ts"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        Int        @id @default(autoincrement())
  createdAt DateTime   @default(now()) @map("created_at")
  sessions  Session[]
  pairCodes PairCode[]
  character Character?

  @@map("users")
}

model AccessCode {
  code      String   @id
  maxUses   Int      @map("max_uses")
  uses      Int      @default(0)
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("access_codes")
}

model Session {
  id        Int      @id @default(autoincrement())
  tokenHash String   @unique @map("token_hash")
  userId    Int      @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at")

  @@map("sessions")
}

/// Short-lived code that logs another device into an existing account (`quest pair`).
model PairCode {
  codeHash  String   @id @map("code_hash")
  userId    Int      @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("pair_codes")
}

model Character {
  id        Int      @id @default(autoincrement())
  userId    Int      @unique @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String   @unique
  xp        Int      @default(0)
  gold      Int      @default(0)
  quests    Quest[]
  createdAt DateTime @default(now()) @map("created_at")

  @@map("characters")
}

/// `slots` is a bitmask, one bit per 5-minute slot with presence. `resolvedAt` is null while running.
model Quest {
  id          Int       @id @default(autoincrement())
  characterId Int       @map("character_id")
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  startedAt   DateTime  @map("started_at")
  endsAt      DateTime  @map("ends_at")
  slots       Int       @default(0)
  resolvedAt  DateTime? @map("resolved_at")
  success     Boolean?
  xp          Int       @default(0)
  gold        Int       @default(0)

  @@index([characterId, startedAt])
  @@map("quests")
}
