generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "ts"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        Int       @id @default(autoincrement())
  email     String    @unique
  createdAt DateTime  @default(now()) @map("created_at")
  sessions  Session[]

  @@map("users")
}

model AccessCode {
  code      String   @id
  maxUses   Int      @map("max_uses")
  uses      Int      @default(0)
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("access_codes")
}

model Session {
  id        Int      @id @default(autoincrement())
  tokenHash String   @unique @map("token_hash")
  userId    Int      @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at")

  @@map("sessions")
}

/// Pending login between `POST /auth/register` and the CLI picking up its token.
model Login {
  idHash      String   @id @map("id_hash")
  linkHash    String   @unique @map("link_hash")
  email       String
  accessCode  String?  @map("access_code")
  confirmCode String   @map("confirm_code")
  userId      Int?     @map("user_id")
  expiresAt   DateTime @map("expires_at")
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("logins")
}
