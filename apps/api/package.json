{
  "name": "@dnd/api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env src/server.ts",
    "start": "node src/server.ts",
    "test": "node --test --test-concurrency=1",
    "typecheck": "tsc",
    "postinstall": "prisma generate",
    "migrate": "prisma migrate dev && prisma generate",
    "access-code": "node --env-file-if-exists=.env src/admin/access-code.ts",
    "ban": "node --env-file-if-exists=.env src/admin/ban.ts",
    "idea": "node --env-file-if-exists=.env src/admin/idea.ts",
    "loadtest": "node --env-file-if-exists=.env scripts/loadtest.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.3",
    "@fastify/rate-limit": "^11.2.1",
    "@fastify/static": "^10.1.6",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@dnd/shared": "workspace:*",
    "fastify": "^5.12.7",
    "pg-boss": "^12.38.0",
    "prisma": "7.10.1"
  },
  "devDependencies": {
    "@types/autocannon": "^7.12.7",
    "autocannon": "^8.0.0"
  }
}
