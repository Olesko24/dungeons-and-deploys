{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "rootDir": "src",
    "outDir": "dist",
    "rewriteRelativeImportExtensions": true,
    // The bin needs LF, a CRLF shebang breaks `quest` on macOS and Linux even when built on Windows.
    "newLine": "lf"
  },
  "exclude": ["src/**/*.test.ts"]
}
